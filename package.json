{
  "name": "sp_project_be",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules npx jest --maxWorkers=1 --forceExit",
    "start:dev": "cross-env NODE_ENV=development nodemon src/app.js",
    "start:prod": "cross-env NODE_ENV=production node src/app.js",
    "lint": "eslint . --fix",
    "pre-commit": "lint-staged",
    "seed:categories": "node src/seed/seedCategories.js",
    "seed:subjects": "node src/seed/seedSubjects.js",
    "seed:languages": "node src/seed/seedLanguages.js",
    "seed:all": "npm run seed:categories && npm run seed:subjects && npm run seed:languages"
    "clear:cache:all": "node src/seed/manualClearCache.js all",
    "clear:cache:languages": "node src/seed/manualClearCache.js languages",
    "clear:cache:locations": "node src/seed/manualClearCache.js locations"
  },
  "author": "SoftServe ITA",
  "license": "ISC",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "eslint": "^8.4.1",
    "eslint-config-prettier": "^8.3.0",
    "jest": "^28.1.3",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^13.0.2",
    "nodemon": "^2.0.15",
    "prettier": "2.5.1",
    "supertest": "^6.2.4"
  },
  "dependencies": {
    "bcrypt": "^5.0.1",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cron": "^2.1.0",
    "dotenv": "^10.0.0",
    "email-templates": "^10.0.0",
    "express": "^4.17.1",
    "googleapis": "^105.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^4.2.2",
    "mongoose": "^6.1.2",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.7.7",
    "pug": "^3.0.2",
    "sharp": "^0.33.5",
    "streamifier": "^0.1.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5",
    "winston": "^3.8.0",
    "zod": "^3.24.1",
    "zod-validation-error": "^3.4.0"
  },
  "lint-staged": {
    "*.{js}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "imports": {
    "#src/*": "./src/*",
    "#configs/*": "./src/configs/*",
    "#initialization/*": "./src/initialization/*",
    "#logger/*": "./src/logger/*",
    "#consts/*": "./src/consts/*",
    "#utils/*": "./src/utils/*",
    "#controllers/*": "./src/controllers/*",
    "#middlewares/*": "./src/middlewares/*",
    "#services/*": "./src/services/*",
    "#cron-jobs/*": "./src/cron-jobs/*",
    "#seed/*": "./src/seed/*",
    "#routes/*": "./src/routes/*",
    "#models/*": "./src/models/*",
    "#validation/*": "./src/validation/*"
  }
}
